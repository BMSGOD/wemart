# This project uses .env.local (gitignored) — copy this file to .env.local and
# fill in the two values. NEVER commit real keys, and NEVER use a service_role
# or secret key in frontend code: everything prefixed with VITE_ becomes
# public in the browser bundle. Only the publishable/anon key belongs here.

# Supabase project URL (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=

# Publishable / anon key (Dashboard → Project Settings → API Keys)
VITE_SUPABASE_KEY=
